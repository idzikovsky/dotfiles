#!/usr/bin/env nu

# Extract node.description from pw-cli/wpctl property output
def description []: string -> string {
    parse -r 'node.description = "(?<name>[^"]*)"' | get name.0
}

# List available audio sinks with their PipeWire node ids
def "main list" []: nothing -> table<index: int, name: string> {
    pw-cli list-objects Node
    | lines
    | parse "{_}id {id}, type {_}"
    | get id
    | each {|id|
        {
            index: ($id | into int),
            info: (pw-cli info $id)
        }
    }
    | where ($it.info | str contains 'media.class = "Audio/Sink"')
    | each {
        {
            index: $in.index,
            name: ($in.info | description)
        }
    }
}

# Check whether a sink is the default one
#
# Exit codes: 0 - sink is the default, 255 - sink exists but is not the default, 1 - sink not found
def "main status" [
    name: string # Sink description, as shown by `list`
]: nothing -> nothing {
    if (wpctl inspect @DEFAULT_AUDIO_SINK@ | description) == $name {
        exit 0
    }
    if (main list | any name == $name) {
        exit 255
    }
    exit 1
}

# Make a sink the default audio output
def "main set" [
    name: string # Sink description, as shown by `list`
]: nothing -> nothing {
    let output_device = main list | where name == $name | first
    if ($output_device | is-empty) {
        exit 1
    }

    wpctl set-default $output_device.index
}

# Switch the default PipeWire audio sink
def main [] {
    help main | print
    exit 1
}
